# URL base pública de la aplicación
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Teléfono de WhatsApp de la tienda (código de país + número, sin signos ni espacios)
# Ejemplo para Colombia: 573001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Credenciales públicas de Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave privada Service Role de Supabase (SOLO SERVIDOR, NUNCA expuesta al cliente)
SUPABASE_SERVICE_ROLE_KEY=
